<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <!--
      Gtk 4 for Windows comes from gvsbuild's release assets. The Gtk 3 bundle
      this replaced was a flat zip built for GtkSharp; gvsbuild's is a full
      install tree, so everything GtkSharp loads lives under bin/.

      The sentinel below and GLibrary's SetDllDirectory must agree with GtkDir
      and with _libraryDefinitions[Library.Gtk][0] -- note there is no "lib"
      prefix on the gvsbuild DLL names.
    -->
    <GtkUrl Condition=" '$(GtkUrl)' == '' ">https://github.com/wingtk/gvsbuild/releases/download/2026.6.0/GTK4_Gvsbuild_2026.6.0_x64.zip</GtkUrl>
    <GtkDir Condition=" '$(GtkDir)' == '' ">$(LOCALAPPDATA)\Gtk\4.22.4</GtkDir>
  </PropertyGroup>

  <Target Name="InstallGtk" BeforeTargets="Build" Condition=" '$(SkipGtkInstall)' != 'True' and '$(OS)' == 'Windows_NT' and !Exists('$(GtkDir)/bin/gtk-4-1.dll') ">
    <Message Importance="High" Text="Gtk has not been detected, downloading and installing it, set SkipGtkInstall to True to skip theese steps."/>
    <Message Importance="High" Text="The Gtk 4 bundle is around 300 MB, so the first build takes a while."/>
    <Message Importance="High" Text="Ignore Gtk extract errors, bug msbuild/issues/3884"/>
    <MakeDir Directories="$(GtkDir)"/>
    <DownloadFile SourceUrl="$(GtkUrl)" DestinationFolder="$(GtkDir)" DestinationFileName="gtk.zip" />
    <Unzip ContinueOnError="true" SourceFiles="$(GtkDir)/gtk.zip" DestinationFolder="$(GtkDir)" />

    <!--
      The bundle ships a Python interpreter and its wheels, used to build Gtk
      rather than to run it. Unzip cannot extract selectively, so they come out
      and are removed afterwards; that is a little over a third of the archive.
    -->
    <ItemGroup>
      <_GtkUnusedDirectory Include="$(GtkDir)\python" />
      <_GtkUnusedDirectory Include="$(GtkDir)\wheels" />
    </ItemGroup>
    <RemoveDir ContinueOnError="true" Directories="@(_GtkUnusedDirectory)" />
    <Delete ContinueOnError="true" Files="$(GtkDir)/gtk.zip" />
  </Target>

</Project>
