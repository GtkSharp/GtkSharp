  <attr path="/api/namespace/interface[@cname='GtkCellLayout']/*[@name='GetCells']/return-type" name="owned">true</attr> 
  <!-- Not hidden: it is an ICellLayout member, so hiding it leaves every
       implementor failing to implement the interface. -->
  <remove-node path="/api/namespace/interface[@cname='GtkColorChooser']/class_struct[@cname='GtkColorChooserInterface']/method[@vm='get_rgba']" />
  <remove-node path="/api/namespace/interface[@cname='GtkColorChooser']/class_struct[@cname='GtkColorChooserInterface']/method[@vm='set_rgba']" />
