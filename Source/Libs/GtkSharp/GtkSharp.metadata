  <attr path="/api/namespace/*[@cname='GtkMediaStream']/property[@cname='ended']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GtkMediaStream']/property[@cname='error']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GtkMediaStream']/property[@cname='has-audio']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GtkMediaStream']/property[@cname='has-video']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GtkMediaStream']/property[@cname='prepared']" name="hidden">1</attr>

  <!-- Iterator value types the hand-written layer extends as "partial struct".
       Boxed defaults to opaque, which generates a class; Gtk 3 carried both of
       these non-opaque. Same treatment as GtkBorder and GtkRequisition. -->
  <attr path="/api/namespace/boxed[@cname='GtkTextIter']" name="opaque">false</attr>
  <attr path="/api/namespace/boxed[@cname='GtkTreeIter']" name="opaque">false</attr>

  <!-- GtkFileChooser's properties each duplicate a Get/Set method pair, and the
       clash surfaces on every implementing class, not on the interface. The
       methods win, as elsewhere. -->
  <attr path="/api/namespace/interface[@cname='GtkFileChooser']/property[@cname='action']" name="hidden">1</attr>
  <attr path="/api/namespace/interface[@cname='GtkFileChooser']/property[@cname='create-folders']" name="hidden">1</attr>
  <attr path="/api/namespace/interface[@cname='GtkFileChooser']/property[@cname='filter']" name="hidden">1</attr>
  <attr path="/api/namespace/interface[@cname='GtkFileChooser']/property[@cname='filters']" name="hidden">1</attr>
  <attr path="/api/namespace/interface[@cname='GtkFileChooser']/property[@cname='select-multiple']" name="hidden">1</attr>
  <attr path="/api/namespace/interface[@cname='GtkFileChooser']/property[@cname='shortcut-folders']" name="hidden">1</attr>

  <!-- A "drop" property and a "drop" signal cannot share a name; the signal wins. -->
  <attr path="/api/namespace/object[@cname='GtkDropTarget']/property[@cname='drop']" name="hidden">1</attr>

  <!-- Properties duplicating a Get/Set method pair on the same type or on an
       interface the type implements. The methods win. -->
  <attr path="/api/namespace/object[@cname='GtkCalendar']/property[@cname='date']" name="hidden">1</attr>
  <attr path="/api/namespace/object[@cname='GtkListBase']/property[@cname='orientation']" name="hidden">1</attr>
  <attr path="/api/namespace/interface[@cname='GtkEditable']/property[@cname='editable']" name="hidden">1</attr>

  <!-- gtk_media_stream_ended was deprecated in 4.4 in favour of
       gtk_media_stream_stream_ended, and its derived name collides with the
       Ended property from gtk_media_stream_get_ended. -->
  <attr path="/api/namespace/object[@cname='GtkMediaStream']/method[@cname='gtk_media_stream_ended']" name="hidden">1</attr>

  <!-- Three Gtk 4 Button constructors all take a single string, so they collide
       as C# overloads. Gtk 3 solved the same clash by making with_label a static
       factory; from_icon_name joins it. -->
  <attr path="/api/namespace/object[@cname='GtkButton']/constructor[@cname='gtk_button_new_from_icon_name']" name="shared">true</attr>

  <!--
    GtkParamSpecExpression derives from GParamSpec, which SymbolTable maps to
    IntPtr, so the generated class would try to derive from nint. GParamSpec is
    not bound as a type anywhere.

    It is already marked fundamental, so dropping the unbindable parent leaves
    ObjectGen to root it at GLib.Opaque like the rest of the Expression
    hierarchy. The declared hierarchy is therefore not the C one: in C this is a
    GParamSpec, and it is bound here as a plain refcounted handle. That is a
    deliberate trade to make the type reachable at all, and it carries no
    ref_func, so lifetime is the caller's business.
  -->
  <remove-attr path="/api/namespace/object[@cname='GtkParamSpecExpression']" name="parent" />

  <!-- The "drop" signal and the Drop property from gtk_drop_target_get_drop
       collide; the signal is renamed, as with ApplyTag/TagApplied in Gtk 3. -->
  <attr path="/api/namespace/object[@cname='GtkDropTarget']/signal[@cname='drop']" name="name">Dropped</attr>

  <!--
    The GtkExpression hierarchy is bound as GLib fundamental types: the api.xml
    carries fundamental="true" plus gtk_expression_ref/unref on the root, and
    ObjectGen roots it at GLib.Opaque rather than GLib.Object.

    Five entry points in it need shapes the api.xml cannot express; all are
    rebound in Source/Libs/GtkSharp/{Expression,ExpressionWatch,ClosureExpression,
    CClosureExpression,TryExpression}.cs.

    gtk_expression_evaluate and gtk_expression_watch_evaluate fill a GValue the
    CALLER provides - the same caller-allocates shape as
    gdk_content_provider_get_value. Codegen copied the managed Value out to
    unmanaged memory, called, and then freed that memory without reading it
    back, so the answer was discarded every time and the method could not do
    the one thing it exists for.

    gtk_expression_bind takes its receiver as (transfer full): the watch it
    creates owns the expression. An api.xml <method> describes its PARAMETERS'
    ownership and has no way to describe the instance's, so the wrapper went on
    owning a reference the callee had eaten and both unreffed.

    gtk_closure_expression_new and gtk_try_expression_new take "T **items plus a
    count", for which codegen has no rule; each came out taking a single
    Expression whose own first machine word the callee then read as element zero.
  -->
  <attr path="/api/namespace/object[@cname='GtkExpression']/method[@cname='gtk_expression_evaluate']" name="hidden">1</attr>
  <attr path="/api/namespace/object[@cname='GtkExpression']/method[@cname='gtk_expression_bind']" name="hidden">1</attr>
  <attr path="/api/namespace/boxed[@cname='GtkExpressionWatch']/method[@cname='gtk_expression_watch_evaluate']" name="hidden">1</attr>
  <attr path="/api/namespace/object[@cname='GtkClosureExpression']/constructor[@cname='gtk_closure_expression_new']" name="hidden">1</attr>
  <attr path="/api/namespace/object[@cname='GtkTryExpression']/constructor[@cname='gtk_try_expression_new']" name="hidden">1</attr>

  <!--
    Signal args classes are named after the signal, so two signals sharing a
    name in one assembly ask GapiCodegen for the same class and only one shape
    can have it. Every other user of that name is then handed members that read
    the wrong Args[] slot: the wrong type, or past the end of the array. It is
    exactly the collision GioSharp fixed for GFileMonitor::changed, and the
    block below is the rest of it in Gtk.

    Found by writing SampleApps/GettingStarted: GestureClick.Pressed was
    reporting GestureLongPress's arguments, so a click's X was really its
    n_press and nothing on the args held the coordinates.

    The rule, following the GFileMonitor precedent: the less-used side moves and
    the cname never changes, so nothing about what is connected natively is
    affected. Where the disagreement is only in a parameter's name or width, the
    parameter is normalised instead and no signal is renamed at all.

    The audit that produced this list groups every signal in an assembly by name
    and reports any name with two or more distinct parameter shapes. A signal
    with no parameters emits System.EventHandler and cannot collide.
  -->

  <!-- pressed: (n_press, x, y) here, (x, y) on GtkGestureLongPress. -->
  <attr path="/api/namespace/object[@cname='GtkGestureLongPress']/signal[@cname='pressed']" name="name">LongPressed</attr>

  <!-- prepare: (page) on the assistant, (x, y) on GtkDragSource. The drag
       source is the one an application reaches for, so the assistant moves. -->
  <attr path="/api/namespace/object[@cname='GtkAssistant']/signal[@cname='prepare']" name="name">PreparePage</attr>

  <!-- drag-begin/drag-end: (GdkDrag) and (GdkDrag, delete_data) on
       GtkDragSource, offsets on GtkGestureDrag. The gesture's shape won, so
       DragSource could not reach the GdkDrag it exists to hand you. -->
  <attr path="/api/namespace/object[@cname='GtkGestureDrag']/signal[@cname='drag-begin']" name="name">DragStarted</attr>
  <attr path="/api/namespace/object[@cname='GtkGestureDrag']/signal[@cname='drag-end']" name="name">DragEnded</attr>

  <!-- change-value: (scroll, value) on GtkRange, (scroll) on GtkSpinButton.
       The spin button's shape won, so a Range handler had no value to read. -->
  <attr path="/api/namespace/object[@cname='GtkSpinButton']/signal[@cname='change-value']" name="name">ChangeValueByScroll</attr>

  <!-- changed: three different shapes, so two of the three must move and the
       third would still be ambiguous with the parameterless "changed" every
       other widget has. All three are named for their owner. -->
  <attr path="/api/namespace/object[@cname='GtkCellRendererCombo']/signal[@cname='changed']" name="name">ComboChanged</attr>
  <attr path="/api/namespace/object[@cname='GtkFilter']/signal[@cname='changed']" name="name">FilterChanged</attr>
  <attr path="/api/namespace/object[@cname='GtkSorter']/signal[@cname='changed']" name="name">SorterChanged</attr>

  <!-- move-cursor: four shapes. FlowBox/IconView/ListBox share one and keep the
       name; the other three are named for the widget family they belong to. -->
  <attr path="/api/namespace/object[@cname='GtkLabel']/signal[@cname='move-cursor']" name="name">MoveTextCursor</attr>
  <attr path="/api/namespace/object[@cname='GtkTextView']/signal[@cname='move-cursor']" name="name">MoveTextCursor</attr>
  <attr path="/api/namespace/object[@cname='GtkText']/signal[@cname='move-cursor']" name="name">MoveEntryCursor</attr>
  <attr path="/api/namespace/object[@cname='GtkTreeView']/signal[@cname='move-cursor']" name="name">MoveTreeCursor</attr>

  <!-- move-focus-out and change-current-page disagree only about what to call a
       parameter of identical type, so renaming the parameter settles it and
       both signals keep their names. -->
  <attr path="/api/namespace/object[@cname='GtkScrolledWindow']/signal[@cname='move-focus-out']/parameters/parameter[@name='direction_type']" name="name">direction</attr>
  <attr path="/api/namespace/object[@cname='GtkShortcutsSection']/signal[@cname='change-current-page']/parameters/parameter[@name='offset']" name="name">page</attr>

  <!-- response: GtkDialog declares GtkResponseType, GtkNativeDialog declares a
       bare gint for the same values. Same width, so widening the native
       dialog's declaration to the enum costs nothing and removes the
       disagreement, and types the member correctly at both ends. -->
  <attr path="/api/namespace/object[@cname='GtkNativeDialog']/signal[@cname='response']/parameters/parameter[@name='response_id']" name="type">GtkResponseType</attr>
</metadata>
