  <!-- Style properties -->



































  <!-- GTK_LICENSE_0BSD derives to "0Bsd", which is not a legal C# identifier.
       StudlyCaps rewrites a leading 2 or 3 as Two/Three but has no rule for 0,
       and it is kept bug-compatible with gapi2xml.pl because ~1900 metadata
       XPaths select on the names it produces. Renamed here in the same spirit. -->
  <attr path="/api/namespace/enum[@cname='GtkLicense']/member[@cname='GTK_LICENSE_0BSD']" name="name">ZeroBsd</attr>

  <!-- Functions whose whole purpose is to raise a signal of the same name.
       Renamed Emit*, as in GioSharp and GdkSharp. -->
  <attr path="/api/namespace/*[@cname='GtkFilter']/method[@cname='gtk_filter_changed']" name="name">EmitChanged</attr>
  <attr path="/api/namespace/*[@cname='GtkIconView']/method[@cname='gtk_icon_view_item_activated']" name="name">EmitItemActivated</attr>
  <attr path="/api/namespace/*[@cname='GtkSectionModel']/method[@cname='gtk_section_model_sections_changed']" name="name">EmitSectionsChanged</attr>
  <attr path="/api/namespace/*[@cname='GtkSelectionModel']/method[@cname='gtk_selection_model_selection_changed']" name="name">EmitSelectionChanged</attr>
  <attr path="/api/namespace/*[@cname='GtkSorter']/method[@cname='gtk_sorter_changed']" name="name">EmitChanged</attr>

  <!-- Here the function performs the action and the signal reports it, so the
       signal is the one renamed - the convention this file already used for
       ApplyTag/TagApplied and InsertPixbuf/PixbufInserted in Gtk 3. -->
  <attr path="/api/namespace/*[@cname='GtkCellArea']/signal[@cname='apply-attributes']" name="name">AttributesApplied</attr>
  <attr path="/api/namespace/*[@cname='GtkDragSource']/signal[@cname='drag-cancel']" name="name">DragCancelled</attr>
