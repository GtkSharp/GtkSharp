  <attr path="/api/namespace/*[@cname='GtkTextBuffer']/signal[@cname='undo']" name="name">Undone</attr>

  <!-- Properties duplicating a method or a Get vfunc on the same type. The
       function wins, as it did in Gtk 3. -->
  <attr path="/api/namespace/*[@cname='GtkColorChooser']/property[@cname='rgba']" name="hidden">1</attr>
  <attr path="/api/namespace/interface[@cname='GtkEditable']/property[@cname='text']" name="hidden">1</attr>

  <!--
    GtkText is bound as Gtk.TextWidget.

    It implements GtkEditable, whose Text member cannot live on a C# class also
    called Text (CS0542). Renaming the member is not a way out: the class then no
    longer satisfies IEditable, and codegen does not emit explicit interface
    implementations. Hiding the type is worse still - other widgets take a
    GtkText in their signatures, so it cascades.

    Renaming the type is the smallest loss. Gtk.Entry, which wraps GtkText and is
    what most code uses, is unaffected and keeps its Text property.
  -->
  <attr path="/api/namespace/object[@cname='GtkText']" name="name">TextWidget</attr>
