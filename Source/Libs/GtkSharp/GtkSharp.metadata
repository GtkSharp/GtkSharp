  <!-- gtk_alert_dialog_new is (const char *format, ...), and codegen emits
       nothing for an ellipsis. With no constructor left, ObjectGen fell back to
       the *protected* void constructor it gives an abstract base class, so the
       type that replaced GtkMessageDialog in Gtk 4 could not be created at all
       from outside the assembly. The fallback is turned off here and public
       constructors are written by hand in AlertDialog.cs. -->
  <attr path="/api/namespace/object[@cname='GtkAlertDialog']" name="disable_void_ctor">1</attr>
