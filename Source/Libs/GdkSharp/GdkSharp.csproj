<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>GdkSharp is a C# wrapper for the Gdk library.</Description>
    <PackageTags>gdk;gdksharp;gdk-sharp;wrapper</PackageTags>
  </PropertyGroup>
  
  <ItemGroup>
    <Compile Include="..\Shared\*.cs">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GLibSharp\GLibSharp.csproj">
      <Name>GLibSharp</Name>
    </ProjectReference>
    <ProjectReference Include="..\GioSharp\GioSharp.csproj">
      <Name>GioSharp</Name>
    </ProjectReference>
    <ProjectReference Include="..\CairoSharp\CairoSharp.csproj">
      <Name>CairoSharp</Name>
    </ProjectReference>
    <ProjectReference Include="..\PangoSharp\PangoSharp.csproj">
      <Name>PangoSharp</Name>
    </ProjectReference>
    <ProjectReference Include="..\GrapheneSharp\GrapheneSharp.csproj">
      <Name>GrapheneSharp</Name>
    </ProjectReference>
  </ItemGroup>

  <!-- Build-time only: PrivateAssets keeps it out of the produced package. The
       condition is on the build host, so packages published by CI (which packs
       in a debian:forky container) go without it. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="Net4x.NuGetUtility" Version="1.0.13" PrivateAssets="all" />
  </ItemGroup>

</Project>
