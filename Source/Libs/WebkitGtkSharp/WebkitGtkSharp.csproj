<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>GtkWebkitSharp is a C# wrapper for the Gtk-Webkit library.</Description>
        <PackageTags>webkitgtk;webkitgtksharp;webkit-sharp;wrapper</PackageTags>
        <RootNamespace>WebKit</RootNamespace>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="..\Shared\*.cs">
            <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
        </Compile>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\GtkSharp\GtkSharp.csproj" />
        <ProjectReference Include="..\JavaScriptCoreSharp\JavaScriptCoreSharp.csproj" />
    </ItemGroup>
    <!-- Build-time only: PrivateAssets keeps it out of the produced package. The
         condition is on the build host, so packages published by CI (which packs
         in a debian:forky container) go without it. -->
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <PackageReference Include="Net4x.NuGetUtility" Version="1.0.13" PrivateAssets="all" />
    </ItemGroup>
</Project>
