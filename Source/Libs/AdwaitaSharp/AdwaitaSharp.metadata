<?xml version="1.0"?>
<metadata>
  <!-- New binding with no history; rules get added here as Phase 4 and Phase 5
       build errors demand them. -->
  <!-- GirToGapi emits the raw shared-library name; GapiCodegen pastes this value
       verbatim into GLibrary.Load(...), so it has to be a C# expression. -->
  <attr path="/api/namespace" name="library">Library.Adwaita</attr>

  <!-- GtkSharp hides GtkBuildable and every implements entry pointing at it
       (GtkSharp.metadata:47 and :93). Libadwaita widgets implement it too, and
       an implements entry naming a hidden interface makes codegen drop the whole
       type - that is what took AdwSidebarSection out. 66 Adw types are affected. -->
  <attr path="/api/namespace/object/implements/interface[@cname='GtkBuildable']" name="hidden">1</attr>

  <!-- adw_message_dialog_response exists to emit ::response, so the function is
       the one renamed - same as GioSharp's GListModel and GdkSharp's
       GdkPaintable. -->
  <attr path="/api/namespace/object[@cname='AdwMessageDialog']/method[@cname='adw_message_dialog_response']" name="name">EmitResponse</attr>

  <!-- adw_tab_view_close_page performs the close and ::close-page is emitted to
       ask whether it should happen, so here the signal is renamed, following
       ApplyTag/TagApplied. -->
  <attr path="/api/namespace/object[@cname='AdwTabView']/signal[@cname='close-page']" name="name">ClosePageRequested</attr>

  <!-- Two arrays whose length is a separate parameter rather than a NULL
       terminator, a shape codegen has no rule for: Replace came out taking one
       AdwNavigationPage where libadwaita wants AdwNavigationPage**, and
       ReplaceWithTags one string where it wants char**. Both handed the callee
       the first machine word of the value as though it were the first element.
       Rebound over arrays in NavigationView.cs. -->
  <attr path="/api/namespace/object[@cname='AdwNavigationView']/method[@cname='adw_navigation_view_replace']" name="hidden">1</attr>
  <attr path="/api/namespace/object[@cname='AdwNavigationView']/method[@cname='adw_navigation_view_replace_with_tags']" name="hidden">1</attr>
</metadata>
