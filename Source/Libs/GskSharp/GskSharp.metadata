<?xml version="1.0"?>
<metadata>
  <!-- Library.Gsk resolves to libgtk-4: GSK is compiled into it rather than shipped
       as its own shared object. See Shared/Library.cs. -->
  <!-- GirToGapi emits the raw shared-library name; GapiCodegen pastes this value
       verbatim into GLibrary.Load(...), so it has to be a C# expression. -->
  <attr path="/api/namespace" name="library">Library.Gsk</attr>

  <!-- gsk_transform_transform sits on GskTransform, so the derived name matches
       its own type and C# rejects it (CS0542). Property.cs already guards
       against this for properties - GtkLabel:label and GtkEditable:editable hit
       it too - but Method.cs does not, and this is the only method in the whole
       tree that does. Renamed rather than patching the generator for one case.
       The C function is gsk_transform_transform: it applies another transform's
       operations to this one. -->
  <attr path="/api/namespace/*[@cname='GskTransform']/method[@cname='gsk_transform_transform']" name="name">TransformWith</attr>

  <!--
    The GskRenderNode hierarchy is bound as GLib fundamental types: the api.xml
    carries fundamental="true" plus gsk_render_node_ref/unref on the root, and
    ObjectGen roots it at GLib.Opaque rather than GLib.Object, so the lifetime
    lands on gsk_render_node_unref. Nothing to hide.
  -->

  <!-- GskPathPoint is an opaque boxed type, and gapi has no marshalling for one
       passed by reference: codegen emits "(IntPtr) point", a cast that does not
       exist. Dropping the direction makes these plain in-parameters, which is
       what the C functions do with the value they are handed. -->
  <remove-attr path="/api/namespace/*[@cname='GskPath']/method[@cname='gsk_path_get_next']/parameters/parameter[@name='point']" name="pass_as" />
  <remove-attr path="/api/namespace/*[@cname='GskPath']/method[@cname='gsk_path_get_previous']/parameters/parameter[@name='point']" name="pass_as" />

  <!-- Two arrays of render nodes that codegen has no rule for, because the length
       is a separate parameter rather than a NULL terminator. Both came out as a
       single GskRenderNode* where GSK wants a GskRenderNode**, so the node's own
       first word - its GskRenderNodeClass pointer - was read back as the first
       element and reffed. Same family as gdk_content_formats_new. Hand-written on
       RenderNode.cs / ContainerNode.cs, over a RenderNode[]. -->
  <attr path="/api/namespace/*[@cname='GskRenderNode']/method[@cname='gsk_render_node_get_children']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GskContainerNode']/constructor[@cname='gsk_container_node_new']" name="hidden">1</attr>

  <!-- Every GskTransform builder takes its receiver as (transfer full): the new
       transform links the old one into its chain and keeps that reference. An
       api.xml <method> can describe its parameters' ownership but never the
       instance's, so the generated wrappers passed Handle and went on owning it
       - a double unref waiting for two finalizers. Same shape as the
       gdk_content_formats_union family. Rebound in Transform.cs, which takes
       the reference the callee eats. -->
  <attr path="/api/namespace/*[@cname='GskTransform']/method[@cname='gsk_transform_invert']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GskTransform']/method[@cname='gsk_transform_matrix']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GskTransform']/method[@cname='gsk_transform_matrix_2d']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GskTransform']/method[@cname='gsk_transform_perspective']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GskTransform']/method[@cname='gsk_transform_rotate']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GskTransform']/method[@cname='gsk_transform_rotate_3d']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GskTransform']/method[@cname='gsk_transform_scale']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GskTransform']/method[@cname='gsk_transform_scale_3d']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GskTransform']/method[@cname='gsk_transform_skew']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GskTransform']/method[@cname='gsk_transform_transform']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GskTransform']/method[@cname='gsk_transform_translate']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GskTransform']/method[@cname='gsk_transform_translate_3d']" name="hidden">1</attr>

  <!-- gsk_path_builder_free_to_path frees the builder outright, the same way
       gdk_content_formats_builder_free_to_formats does. Rebound in
       PathBuilder.cs so that a method does not destroy its receiver. -->
  <attr path="/api/namespace/*[@cname='GskPathBuilder']/method[@cname='gsk_path_builder_free_to_path']" name="hidden">1</attr>

  <!-- The gradient nodes take (const GskColorStop *stops, gsize n_stops). Codegen
       has no rule for an array whose length is a sibling parameter, so it emitted
       a single ColorStop by value plus a caller-supplied count - one struct's
       worth of memory described to GSK as n. A gradient needs at least two stops,
       so every correct call read past the end of a 20-byte allocation. Same shape
       as gsk_container_node_new. Rebound over ColorStop[] in GradientNodes.cs,
       which is also where the count comes from. -->
  <attr path="/api/namespace/*[@cname='GskLinearGradientNode']/constructor[@cname='gsk_linear_gradient_node_new']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GskRepeatingLinearGradientNode']/constructor[@cname='gsk_repeating_linear_gradient_node_new']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GskRadialGradientNode']/constructor[@cname='gsk_radial_gradient_node_new']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GskRepeatingRadialGradientNode']/constructor[@cname='gsk_repeating_radial_gradient_node_new']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GskConicGradientNode']/constructor[@cname='gsk_conic_gradient_node_new']" name="hidden">1</attr>

  <!-- ...and the matching getters return (const GskColorStop *, out n_stops).
       Wrapping only the first element silently discarded every stop but one, so
       a gradient could be built and then never read back. -->
  <attr path="/api/namespace/*[@cname='GskLinearGradientNode']/method[@cname='gsk_linear_gradient_node_get_color_stops']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GskRadialGradientNode']/method[@cname='gsk_radial_gradient_node_get_color_stops']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GskConicGradientNode']/method[@cname='gsk_conic_gradient_node_get_color_stops']" name="hidden">1</attr>

  <!-- gsk_shadow_node_new (child, const GskShadow *shadows, gsize n_shadows) is
       the same array-plus-count shape, and a drop shadow with two shadows is the
       ordinary case rather than an exotic one. -->
  <attr path="/api/namespace/*[@cname='GskShadowNode']/constructor[@cname='gsk_shadow_node_new']" name="hidden">1</attr>

  <!-- gsk_border_node_get_widths returns "const float *" - four floats, one per
       edge - and gsk_border_node_get_colors returns four GdkRGBA. The api.xml
       records the element type with no length, so codegen declared the P/Invoke
       as *returning a float* and as returning one RGBA: on x86-64 the widths
       getter read XMM0 while the pointer was in RAX, so it answered with
       whatever the last float operation had left behind. Rebound over arrays in
       BorderNode.cs. The constructor is fine - its parameters carry
       array_len="4", which codegen does understand. -->
  <attr path="/api/namespace/*[@cname='GskBorderNode']/method[@cname='gsk_border_node_get_widths']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GskBorderNode']/method[@cname='gsk_border_node_get_colors']" name="hidden">1</attr>

  <!-- gsk_stroke_set_dash (stroke, const float *dash, gsize n_dash) came out as
       SetDash(ulong n_dash) returning a float: the array parameter became an
       "out float", so GSK was handed a pointer to four bytes of stack and told
       to read n_dash floats from it. There was no way to set a dash pattern at
       all, and the obvious call corrupted the caller's frame. The getter has the
       mirror-image problem. Both rebound in Stroke.cs. -->
  <attr path="/api/namespace/*[@cname='GskStroke']/method[@cname='gsk_stroke_set_dash']" name="hidden">1</attr>
  <attr path="/api/namespace/*[@cname='GskStroke']/method[@cname='gsk_stroke_get_dash']" name="hidden">1</attr>
</metadata>
