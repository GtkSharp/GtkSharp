<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>PangoSharp is a C# wrapper for the Pango library.</Description>
    <PackageTags>pango;pangosharp;pango-sharp;wrapper</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GLibSharp\GLibSharp.csproj">
      <Name>GLibSharp</Name>
    </ProjectReference>
    <ProjectReference Include="..\CairoSharp\CairoSharp.csproj">
      <Name>CairoSharp</Name>
    </ProjectReference>
  </ItemGroup>

  <!-- Build-time only: PrivateAssets keeps it out of the produced package. The
       condition is on the build host, so packages published by CI (which packs
       in a debian:forky container) go without it. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="Net4x.NuGetUtility" Version="1.0.13" PrivateAssets="all" />
  </ItemGroup>

</Project>
