<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <!-- Gtk 4 removed GtkBin, so the template is rooted at GtkBox. Child packing
       properties are gone too: expand/fill are now properties of the child
       widget itself (hexpand/vexpand), and position is implied by order.

       The <signal> elements the Gtk 3 template used are deliberately absent.
       Connecting them needs GtkBuilderScope, which GtkSharp does not bind yet,
       and a template that declares signals throws at construction. The handlers
       are wired in the constructor instead. -->
  <template class="CompositeWidget" parent="GtkBox">
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkBox">
        <child>
          <object class="GtkButton" id="btn1">
            <property name="label" translatable="yes">Instance handler</property>
            <property name="receives-default">True</property>
            <property name="margin-start">3</property>
            <property name="margin-end">3</property>
            <property name="margin-top">3</property>
            <property name="margin-bottom">3</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="btn2">
            <property name="label" translatable="yes">Static handler</property>
            <property name="receives-default">True</property>
            <property name="margin-start">3</property>
            <property name="margin-end">3</property>
            <property name="margin-top">3</property>
            <property name="margin-bottom">3</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkEntry" id="label">
        <property name="margin-start">3</property>
        <property name="margin-end">3</property>
        <property name="margin-top">3</property>
        <property name="margin-bottom">3</property>
      </object>
    </child>
  </template>
</interface>
