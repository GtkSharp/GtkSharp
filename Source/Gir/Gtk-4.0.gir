          <parameter name="out_start"
                     direction="out"
                     caller-allocates="0"
                     transfer-ownership="full">
            <doc xml:space="preserve"
                 filename="gtk/gtksectionmodel.c"
                 line="117">the position of the first item in the section</doc>
            <type name="guint" c:type="guint*"/>
          </parameter>
          <parameter name="out_end"
                     direction="out"
                     caller-allocates="0"
                     transfer-ownership="full">
            <doc xml:space="preserve"
                 filename="gtk/gtksectionmodel.c"
                 line="118">the position of the first item not part of the section
