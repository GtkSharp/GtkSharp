        <parameters>
          <parameter name="target"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gtk/gtkconstraint.c"
                 line="311">the target of the constraint</doc>
            <type name="ConstraintTarget" c:type="gpointer"/>
