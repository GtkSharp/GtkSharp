           glib:type-struct="GestureSwipeClass">
      <doc xml:space="preserve"
           filename="gtk/gtkgestureswipe.c"
           line="21">Recognizes swipe gestures.

After a press/move/.../move/release sequence happens, the
[signal@Gtk.GestureSwipe::swipe] signal will be emitted,
providing the velocity and directionality of the sequence
at the time it was lifted.

If the velocity is desired in intermediate points,
[method@Gtk.GestureSwipe.get_velocity] can be called in a
[signal@Gtk.Gesture::update] handler.

All velocities are reported in pixels/sec units.</doc>
      <source-position filename="gtk/gtkgestureswipe.h" line="39"/>
      <constructor name="new" c:identifier="gtk_gesture_swipe_new">
        <doc xml:space="preserve"
             filename="gtk/gtkgestureswipe.c"
             line="269">Returns a newly created `GtkGesture` that recognizes swipes.</doc>
        <source-position filename="gtk/gtkgestureswipe.h" line="45"/>
        <return-value transfer-ownership="full">
          <doc xml:space="preserve"
               filename="gtk/gtkgestureswipe.c"
               line="274">a newly created `GtkGestureSwipe`</doc>
          <type name="Gesture" c:type="GtkGesture*"/>
        </return-value>
      </constructor>
      <method name="get_velocity"
              c:identifier="gtk_gesture_swipe_get_velocity">
        <doc xml:space="preserve"
             filename="gtk/gtkgestureswipe.c"
             line="283">Gets the current velocity.

If the gesture is recognized, this function returns %TRUE and fills
in @velocity_x and @velocity_y with the recorded velocity, as per the
last events processed.</doc>
        <source-position filename="gtk/gtkgestureswipe.h" line="48"/>
        <return-value transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gtk/gtkgestureswipe.c"
               line="295">whether velocity could be calculated</doc>
          <type name="gboolean" c:type="gboolean"/>
        </return-value>
        <parameters>
          <instance-parameter name="gesture" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkgestureswipe.c"
                 line="285">a `GtkGestureSwipe`</doc>
            <type name="GestureSwipe" c:type="GtkGestureSwipe*"/>
          </instance-parameter>
          <parameter name="velocity_x"
                     direction="out"
                     caller-allocates="0"
                     transfer-ownership="full">
            <doc xml:space="preserve"
                 filename="gtk/gtkgestureswipe.c"
                 line="286">return value for the velocity in the X axis, in pixels/sec</doc>
            <type name="gdouble" c:type="double*"/>
          </parameter>
          <parameter name="velocity_y"
                     direction="out"
                     caller-allocates="0"
                     transfer-ownership="full">
            <doc xml:space="preserve"
                 filename="gtk/gtkgestureswipe.c"
                 line="287">return value for the velocity in the Y axis, in pixels/sec</doc>
            <type name="gdouble" c:type="double*"/>
          </parameter>
        </parameters>
      </method>
      <glib:signal name="swipe" when="last">
        <doc xml:space="preserve"
             filename="gtk/gtkgestureswipe.c"
             line="237">Emitted when the recognized gesture is finished.

Velocity and direction are a product of previously recorded events.</doc>
