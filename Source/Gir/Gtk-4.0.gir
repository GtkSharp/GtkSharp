                 filename="gtk/gtkwidget.c"
                 line="3132">a widget</doc>
            <type name="Widget" c:type="GtkWidget*"/>
          </instance-parameter>
          <parameter name="callback"
                     transfer-ownership="none"
                     scope="notified"
                     closure="1"
                     destroy="2">
            <doc xml:space="preserve"
                 filename="gtk/gtkwidget.c"
                 line="3133">function
  to call for updating animations</doc>
