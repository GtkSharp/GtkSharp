            <doc xml:space="preserve"
                 filename="gtk/gtkaccessibletext.h"
                 line="195">the number of attributes</doc>
            <type name="gsize" c:type="gsize*"/>
          </parameter>
          <parameter name="ranges"
                     direction="out"
                     caller-allocates="0"
                     transfer-ownership="container"
                     optional="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gtk/gtkaccessibletext.h"
                 line="196">the ranges of the attributes
  inside the accessible object</doc>
