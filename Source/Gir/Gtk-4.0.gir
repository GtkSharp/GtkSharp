            <doc xml:space="preserve"
                 filename="gtk/gtktextview.c"
                 line="2480">a `GtkTextView`</doc>
            <type name="TextView" c:type="GtkTextView*"/>
          </instance-parameter>
          <parameter name="iter"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
