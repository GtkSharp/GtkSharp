          <parameter name="allocation"
                     direction="out"
                     caller-allocates="1"
                     transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkoverlay.c"
                 line="338">return
  location for the allocation</doc>
            <type name="Gdk.Rectangle"/>
