        <doc xml:space="preserve"
             filename="gtk/gtksnapshot.c"
             line="3209">Appends a stroked border rectangle inside the given @outline.

The four sides of the border can have different widths and colors.</doc>
        <source-position filename="gtk/gtksnapshot.h" line="237"/>
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
        <parameters>
          <instance-parameter name="snapshot" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtksnapshot.c"
                 line="3211">a `GtkSnapshot`</doc>
            <type name="Snapshot" c:type="GtkSnapshot*"/>
          </instance-parameter>
          <parameter name="outline" transfer-ownership="none">
