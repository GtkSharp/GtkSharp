                 filename="gtk/gtkgesturelongpress.c"
                 line="376">A `GtkGestureLongPress`</doc>
            <type name="GestureLongPress" c:type="GtkGestureLongPress*"/>
          </instance-parameter>
        </parameters>
      </method>
      <method name="set_delay_factor"
              c:identifier="gtk_gesture_long_press_set_delay_factor"
              glib:set-property="delay-factor">
        <doc xml:space="preserve"
             filename="gtk/gtkgesturelongpress.c"
