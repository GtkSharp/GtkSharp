      <virtual-method name="create_closure" throws="1">
        <doc xml:space="preserve"
             filename="gtk/gtkbuilderscope.h"
             line="63">Create a closure with the given arguments. See gtk_builder_create_closure()
  for more details on those.
  The C implementation will try to use dlsym() to locate the function name and then
  g_cclosure_new() to create a closure for the symbol.
  The default implementation just fails and returns %NULL.</doc>
        <source-position filename="gtk/gtkbuilderscope.h" line="86"/>
        <return-value transfer-ownership="full">
          <type name="GObject.Closure" c:type="GClosure*"/>
