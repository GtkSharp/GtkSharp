            <doc xml:space="preserve"
                 filename="gtk/gtknumericsorter.c"
                 line="617">a `GtkNumericSorter`</doc>
            <type name="NumericSorter" c:type="GtkNumericSorter*"/>
          </instance-parameter>
          <parameter name="expression"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gtk/gtknumericsorter.c"
                 line="618">a `GtkExpression`</doc>
