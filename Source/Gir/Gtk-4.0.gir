          <parameter name="iter" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/deprecated/gtktreemodel.c"
                 line="1758">the `GtkTreeIter`</doc>
            <type name="TreeIter" c:type="GtkTreeIter*"/>
          </parameter>
        </parameters>
