                 line="243">mark name</doc>
            <type name="utf8" c:type="const char*"/>
          </parameter>
          <parameter name="left_gravity" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtktextmark.c"
                 line="244">whether the mark should have left gravity</doc>
            <type name="gboolean" c:type="gboolean"/>
          </parameter>
        </parameters>
      </constructor>
