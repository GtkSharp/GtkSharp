    <class name="IconPaintable"
           c:symbol-prefix="icon_paintable"
           c:type="GtkIconPaintable"
           parent="GObject.Object"
           glib:type-name="GtkIconPaintable"
           glib:get-type="gtk_icon_paintable_get_type"
           glib:type-struct="IconPaintableClass">
      <doc xml:space="preserve"
           filename="gtk/gtkiconpaintable.c"
           line="32">Contains information found when looking up an icon in `GtkIconTheme`
or loading it from a file.

`GtkIconPaintable` implements `GdkPaintable` and `GtkSymbolicPaintable`.</doc>
      <source-position filename="gtk/gtkiconpaintable.h" line="31"/>
      <implements name="Gdk.Paintable"/>
      <implements name="SymbolicPaintable"/>
      <constructor name="new_for_file"
                   c:identifier="gtk_icon_paintable_new_for_file">
        <doc xml:space="preserve"
             filename="gtk/gtkiconpaintable.c"
             line="761">Creates a `GtkIconPaintable` for a file with a given size and scale.

The icon can then be rendered by using it as a `GdkPaintable`.</doc>
        <source-position filename="gtk/gtkiconpaintable.h" line="34"/>
        <return-value transfer-ownership="full">
          <doc xml:space="preserve"
               filename="gtk/gtkiconpaintable.c"
               line="771">a `GtkIconPaintable` containing
  for the icon. Unref with g_object_unref()</doc>
          <type name="IconPaintable" c:type="GtkIconPaintable*"/>
        </return-value>
        <parameters>
          <parameter name="file" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkiconpaintable.c"
                 line="763">a `GFile`</doc>
            <type name="Gio.File" c:type="GFile*"/>
          </parameter>
          <parameter name="size" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkiconpaintable.c"
                 line="764">desired icon size, in application pixels</doc>
            <type name="gint" c:type="int"/>
          </parameter>
          <parameter name="scale" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkiconpaintable.c"
                 line="765">the desired scale</doc>
            <type name="gint" c:type="int"/>
          </parameter>
        </parameters>
      </constructor>
      <method name="get_file"
              c:identifier="gtk_icon_paintable_get_file"
              glib:get-property="file">
        <doc xml:space="preserve"
             filename="gtk/gtkiconpaintable.c"
             line="834">Gets the `GFile` that was used to load the icon.

Returns %NULL if the icon was not loaded from a file.</doc>
        <source-position filename="gtk/gtkiconpaintable.h" line="39"/>
        <return-value transfer-ownership="full" nullable="1">
          <doc xml:space="preserve"
               filename="gtk/gtkiconpaintable.c"
               line="842">the `GFile` for the icon</doc>
          <type name="Gio.File" c:type="GFile*"/>
        </return-value>
        <parameters>
          <instance-parameter name="self" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkiconpaintable.c"
                 line="836">a `GtkIconPaintable`</doc>
            <type name="IconPaintable" c:type="GtkIconPaintable*"/>
          </instance-parameter>
        </parameters>
      </method>
      <method name="get_icon_name"
              c:identifier="gtk_icon_paintable_get_icon_name"
              glib:get-property="icon-name"
              deprecated="1"
              deprecated-version="4.20">
        <doc xml:space="preserve"
             filename="gtk/gtkiconpaintable.c"
             line="807">Get the icon name being used for this icon.

When an icon looked up in the icon theme was not available, the
icon theme may use fallback icons - either those specified to
gtk_icon_theme_lookup_icon() or the always-available
"image-missing". The icon chosen is returned by this function.

If the icon was created without an icon theme, this function
returns %NULL.</doc>
        <source-position filename="gtk/gtkiconpaintable.h" line="41"/>
        <return-value transfer-ownership="none" nullable="1">
          <doc xml:space="preserve"
               filename="gtk/gtkiconpaintable.c"
               line="821">the themed icon-name for the
  icon, or %NULL if its not a themed icon.</doc>
          <type name="filename" c:type="const char*"/>
        </return-value>
        <parameters>
          <instance-parameter name="self" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkiconpaintable.c"
                 line="809">a `GtkIconPaintable`</doc>
            <type name="IconPaintable" c:type="GtkIconPaintable*"/>
          </instance-parameter>
        </parameters>
      </method>
      <method name="is_symbolic"
