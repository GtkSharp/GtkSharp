          </instance-parameter>
          <parameter name="incremental" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gtk/gtkfilterlistmodel.c"
                 line="1095">%TRUE to enable incremental filtering</doc>
            <type name="gboolean" c:type="gboolean"/>
          </parameter>
        </parameters>
