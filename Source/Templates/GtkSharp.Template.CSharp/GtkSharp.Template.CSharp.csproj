<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>Gtk templates for CSharp</Title>
    <PackageId>GtkSharp.Template.CSharp</PackageId>
    <PackageId Condition="'$(WorkloadBuild)' == 'true'">GtkSharp.Workload.Template.CSharp</PackageId>
    <Description>A set of C# templates for your .Net Gtk Application.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ReplacementFile
      Include="content\GtkSharp.Application.CSharp\.template.config\template.in.json"
      Destination="$(IntermediateOutputPath)cs-template.json"
      Pack="true"
      PackagePath="content\content\GtkSharp.Application.CSharp\.template.config\template.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="content/**/*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../Libs/GtkSharp/Icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>