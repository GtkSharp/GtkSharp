<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <!-- Loaded through Builder(Assembly, resourceName, ...) by
       BuilderBindingTests. Deliberately declares no <signal>: the word appears
       in this comment so that a builder which greps for it rather than parsing
       would wrongly conclude the document needs handlers. -->
  <object class="GtkBox" id="root">
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkLabel" id="greeting">
        <property name="label">from an embedded resource</property>
      </object>
    </child>
  </object>
</interface>
