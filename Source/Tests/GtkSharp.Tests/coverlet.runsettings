<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage settings for the test run.

  Applied automatically: GtkSharp.Tests.csproj sets RunSettingsFilePath to this
  file, so `dotnet test` with the XPlat code coverage collector picks it up without
  anyone remembering a command-line flag.

  The point of it is ExcludeByFile below. The generated sources carry
  `// <auto-generated />` as their first line, which makes Roslyn skip them for
  analyser diagnostics. But coverlet has never read that marker, and no coverage
  tool in this pipeline does. Excluding generated code from coverage is a
  separate mechanism, and this file is it.

  Why exclude it at all: Generated/ is a mechanical rendering of the api.xml. It
  holds a wrapper for every function in every bound library, most of which no
  application will ever call, so its coverage is a number nobody can act on. At
  233k generated lines against 22k hand-written, leaving it in drags the reported
  figure from about 66 per cent down to about 17, and hides the one that matters.
  See Docs/coverage.md.

  Note for editors: an XML comment may not contain two consecutive hyphens.
  VSTest rejects the whole file if it does, with "Settings file provided does not
  conform to required format", and the test run then proceeds with no coverage
  configuration at all.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>

          <!-- Everything under a Generated/ directory, on either path separator.
               That is exactly where GapiCodegen writes and nowhere else: the
               hand-written partial classes live one level up, in
               Source/Libs/<Name>/. -->
          <ExcludeByFile>**/Generated/**/*.cs</ExcludeByFile>

          <!-- Belt and braces for anything generated that ends up outside a
               Generated/ directory, and for the compiler's own emissions. -->
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>

          <!-- Trivial property accessors are noise either way, and counting them
               flatters the number. -->
          <SkipAutoProps>true</SkipAutoProps>

          <Format>cobertura</Format>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
