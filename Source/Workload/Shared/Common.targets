<Project>
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<PackageType>DotnetPlatform</PackageType>
		<!-- The package id is the project name. These ids are also resolved by
         name out of the workload manifest, so WorkloadManifest.in.json,
         WorkloadManifest.targets, Sdk.in.targets and build.cake's packNames all
         spell them the same way and have to move together. -->
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<IncludeSymbols>false</IncludeSymbols>
		<NoWarn>$(NoWarn);NU5100;NU5128;NU5130;NU5131</NoWarn>
	</PropertyGroup>
</Project>