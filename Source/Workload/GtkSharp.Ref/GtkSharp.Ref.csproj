<Project Sdk="Microsoft.Build.NoTargets">
    <Import Project="$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.props" Condition="$([MSBuild]::IsOSPlatform('Windows')) and Exists('$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.props')" />
    <PropertyGroup>
        <PackageOutputPath>$(SolutionDir)BuildOutput/NugetPackages/</PackageOutputPath>
    </PropertyGroup>
    <PropertyGroup>
        <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    </PropertyGroup>
    <PropertyGroup>
        <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    </PropertyGroup>
    <Import Project="..\Shared\Common.targets" />
    <PropertyGroup>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <Content Include="README.md" Link="README.md" Pack="true" PackagePath="\README.md" />
        <Content Include="$(SolutionDir)License.txt" Link="License.txt" Pack="true" PackagePath="\License.txt" Condition="$([MSBuild]::IsOSPlatform('Windows')) and Exists('$(SolutionDir)License.txt')" />
    </ItemGroup>
    <Import Project="..\Shared\Frameworks.targets" />
    <PropertyGroup>
        <Description>GtkSharp targeting pack</Description>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="$(_GtkSharpSourceDirectory)Libs\**\*.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Named off the wrapper projects rather than globbed out of the output
             directory: the wrappers build once, for $(_GtkSharpLibTfm), and that
             directory is shared with anything else built for the same framework
             (the template projects land there too). The pack still ships them
             under the net$(_GtkSharpNetVersion)-gtk TFM consumers reference. -->
        <None Include="@(ProjectReference->'$(_GtkSharpBuildOutputDirectory)$(Configuration)\$(_GtkSharpLibTfm)\%(FileName).dll')" />
        <None Update="@(None)" CopyToOutputDirectory="PreserveNewest" Visible="false" Link="ref\$(_GtkSharpFullTfm)\%(FileName)%(Extension)" />
        <_PackageFiles Include="@(None)" PackagePath="ref\$(_GtkSharpFullTfm)" TargetPath="ref\$(_GtkSharpFullTfm)" />
    </ItemGroup>
    <!-- Build-time only: PrivateAssets keeps it out of the produced package. The
       condition is on the build host, so packages published by CI (which packs
       in a debian:forky container) go without it. -->
    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <PackageReference Include="Net4x.NuGetUtility" Version="1.0.13" PrivateAssets="all" />
    </ItemGroup>
    <Import Project="$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.targets" Condition="$([MSBuild]::IsOSPlatform('Windows')) and Exists('$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.targets')" />
</Project>