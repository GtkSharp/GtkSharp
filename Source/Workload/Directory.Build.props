<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..\'))" />

  <PropertyGroup>
    <!-- The Gtk release, not the package version. This used to be the first two
         components of $(Version), which worked only while the package version
         was itself a Gtk version. It is now a build date, which says nothing
         about Gtk, so the TFM reads the explicit property instead and
         net$(_GtkSharpNetVersion)-gtk4.22 stays put for consumers. -->
    <_GtkSharpVersion>$(_GtkSharpPlatformVersion)</_GtkSharpVersion>
    <_GtkSharpTfm>net$(_GtkSharpNetVersion)-gtk</_GtkSharpTfm>
    <_GtkSharpFullTfm>net$(_GtkSharpNetVersion)-gtk$(_GtkSharpVersion)</_GtkSharpFullTfm>
    <_GtkSharpManifestVersionBand Condition=" '$(_GtkSharpManifestVersionBand)' == '' ">8.0.200</_GtkSharpManifestVersionBand>
    <!-- Folder format somewhat similar to packs in .NET, making stuff easier to install -->
    <OutputPath>$(_GtkSharpBuildOutputDirectory)WorkloadPacks\$(Configuration)\$(MSBuildProjectName)\$(Version)</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(_GtkSharpSourceDirectory)Libs\GtkSharp\Icon.png" Pack="true" PackagePath="\" />
    <!-- Each workload pack has a README.md beside its .csproj. Most of them say
         "you do not install this directly", which is the single most useful
         thing a workload pack's page on nuget.org can say. -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Icon.png</PackageIcon>
    <Authors>GtkSharp Contributors</Authors>
  </PropertyGroup>

</Project>
