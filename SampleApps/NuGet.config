<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- <clear /> deliberately: this solution is meant to restore the way a
         real consumer would, from a feed, rather than through ProjectReference
         into the repository next door.

         The local folder is listed first so packages built in this repository
         (BuildTarget=PackageNuGet) can be tried before anything is published.
         It is harmless when empty: NuGet just falls through to the next
         source. -->
    <clear />
    <add key="local-buildoutput" value="..\BuildOutput\NugetPackages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
