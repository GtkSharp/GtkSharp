<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GettingStarted</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <GtkSharpVersion>4.22.4.*</GtkSharpVersion>

    <GtkSharpPackagePrefix></GtkSharpPackagePrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="$(GtkSharpPackagePrefix)GtkSharp4" Version="$(GtkSharpVersion)" />
    <PackageReference Include="$(GtkSharpPackagePrefix)GLibSharp4" Version="$(GtkSharpVersion)" />
    <PackageReference Include="$(GtkSharpPackagePrefix)GioSharp4" Version="$(GtkSharpVersion)" />
    <PackageReference Include="$(GtkSharpPackagePrefix)GdkSharp4" Version="$(GtkSharpVersion)" />
    <PackageReference Include="$(GtkSharpPackagePrefix)PangoSharp4" Version="$(GtkSharpVersion)" />
    <PackageReference Include="$(GtkSharpPackagePrefix)CairoSharp4" Version="$(GtkSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded under its bare filename, because that is the name
         `new Builder("MainWindow.ui")` looks the resource up by. -->
    <None Remove="**\*.ui" />
    <EmbeddedResource Include="**\*.ui">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
