<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GettingStarted</RootNamespace>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <!-- One place to bump. -->
    <GtkSharpVersion>4.22.4.1</GtkSharpVersion>

    <!-- Empty here, because this branch packs the ids unprefixed. The
         net4x.gtk4 branch publishes the same packages as Net4x.GtkSharp,
         Net4x.GLibSharp and so on, so building against those is

             dotnet build -p:GtkSharpPackagePrefix=Net4x.

         The prefix is on the FEED ID only either way: the assemblies inside are
         still GtkSharp.dll, GLibSharp.dll and the namespaces are unprefixed, so
         not one line of the code below changes between the two. -->
    <GtkSharpPackagePrefix></GtkSharpPackagePrefix>
  </PropertyGroup>

  <ItemGroup>
    <!-- Net4x.GtkSharp alone would be enough, since GLib, Gio, Gdk, Gsk, Pango
         and Cairo arrive as its dependencies. They are named explicitly because
         this tour calls all of them directly, and an explicit reference is
         what stops a transitive dependency quietly changing underneath it. -->
    <PackageReference Include="$(GtkSharpPackagePrefix)GtkSharp" Version="$(GtkSharpVersion)" />
    <PackageReference Include="$(GtkSharpPackagePrefix)GLibSharp" Version="$(GtkSharpVersion)" />
    <PackageReference Include="$(GtkSharpPackagePrefix)GioSharp" Version="$(GtkSharpVersion)" />
    <PackageReference Include="$(GtkSharpPackagePrefix)GdkSharp" Version="$(GtkSharpVersion)" />
    <PackageReference Include="$(GtkSharpPackagePrefix)PangoSharp" Version="$(GtkSharpVersion)" />
    <PackageReference Include="$(GtkSharpPackagePrefix)CairoSharp" Version="$(GtkSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded under its bare filename, because that is the name
         `new Builder("MainWindow.ui")` looks the resource up by. -->
    <None Remove="**\*.ui" />
    <EmbeddedResource Include="**\*.ui">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
